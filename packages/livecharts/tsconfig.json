{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@livecharts/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "../core/src", "../react/src"],
  "exclude": [
    "node_modules",
    "dist",
    "../core/src/**/__tests__",
    "../react/src/**/__tests__"
  ]
}
