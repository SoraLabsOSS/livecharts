{
  "name": "livecharts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:pages": "turbo run build:pages",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "ultracite": "7.10.1"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18"
  }
}
